<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tiendanube: Landing Pages Como Experto — Generador de Prompt</title>
<style>
  :root{
    --primario:#a200ff;
    --primario-oscuro:#6b00cc;
    --acento:#c14dff;
    --bg:#0a0010;
    --card:#160a1e;
    --border:rgba(162,0,255,0.25);
    --text:#f0f0f0;
    --muted:#999;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    font-family:'Poppins',-apple-system,BlinkMacSystemFont,sans-serif;
    background:linear-gradient(180deg,#0a0010 0%,#120018 100%);
    color:var(--text);
    padding-bottom:80px;
  }
  header.hero{
    background:linear-gradient(135deg,#1a0033 0%,#3d0080 45%,#a200ff 100%);
    padding:44px 20px 38px 20px;
    text-align:center;
  }
  header.hero .kicker{
    font-size:11px;letter-spacing:3px;font-weight:700;color:#d9b3ff;
    text-transform:uppercase;margin-bottom:10px;
  }
  header.hero h1{
    font-size:26px;font-weight:900;margin:0 0 10px 0;line-height:1.2;
  }
  header.hero h1 span{color:#ff9de8;}
  header.hero p{
    font-size:13.5px;color:#eaddff;max-width:540px;margin:0 auto;line-height:1.6;
  }
  main{
    max-width:640px;margin:0 auto;padding:24px 16px;
  }
  .card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:14px;
    padding:20px;
    margin-bottom:16px;
  }
  .card h2{
    font-size:15px;font-weight:900;color:#fff;margin:0 0 4px 0;
    display:flex;align-items:center;gap:8px;
  }
  .card h2 .n{
    display:inline-flex;align-items:center;justify-content:center;
    width:24px;height:24px;border-radius:50%;background:var(--primario);
    color:#fff;font-size:12px;font-weight:900;flex:0 0 auto;
  }
  .card .hint{
    font-size:11.5px;color:var(--muted);margin:0 0 14px 0;line-height:1.5;
  }
  label{
    display:block;font-size:12px;font-weight:700;color:#ddd;margin:12px 0 5px 0;
  }
  label:first-of-type{margin-top:0;}
  input[type="text"],input[type="number"],textarea{
    width:100%;background:#0d0512;border:1px solid rgba(255,255,255,0.12);
    border-radius:8px;color:#fff;padding:10px 12px;font-size:13px;
    font-family:inherit;
  }
  input[type="text"]:focus,input[type="number"]:focus,textarea:focus{
    outline:none;border-color:var(--primario);
  }
  textarea{resize:vertical;min-height:70px;line-height:1.5;}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;}
  @media(max-width:480px){.row3{grid-template-columns:1fr;}}
  .foto-item{
    background:#0d0512;border:1px solid rgba(255,255,255,0.08);
    border-radius:10px;padding:12px;margin-bottom:8px;
  }
  .foto-item .foto-label{
    font-size:11px;font-weight:800;color:var(--acento);margin-bottom:6px;
    display:flex;align-items:center;gap:6px;
  }
  .color-row{display:flex;align-items:center;gap:12px;margin-bottom:10px;}
  input[type="color"]{
    width:46px;height:46px;border:none;border-radius:10px;cursor:pointer;
    background:none;padding:0;
  }
  .swatches{display:flex;gap:10px;margin-top:10px;}
  .swatch{flex:1;text-align:center;}
  .swatch .box{
    height:36px;border-radius:8px;margin-bottom:5px;border:1px solid rgba(255,255,255,0.15);
  }
  .swatch span{font-size:9.5px;color:var(--muted);font-weight:700;}
  .toggle-row{
    display:flex;align-items:center;justify-content:space-between;
    background:#0d0512;border:1px solid rgba(255,255,255,0.1);
    border-radius:10px;padding:10px 14px;margin-bottom:10px;
  }
  .toggle-row span{font-size:12.5px;font-weight:700;}
  .switch{position:relative;width:42px;height:24px;flex:0 0 auto;}
  .switch input{opacity:0;width:0;height:0;}
  .slider{
    position:absolute;inset:0;background:#333;border-radius:99px;cursor:pointer;
    transition:.2s;
  }
  .slider::before{
    content:'';position:absolute;width:18px;height:18px;left:3px;top:3px;
    background:#fff;border-radius:50%;transition:.2s;
  }
  input:checked + .slider{background:var(--primario);}
  input:checked + .slider::before{transform:translateX(18px);}
  .conditional{display:none;margin-top:6px;}
  .conditional.show{display:block;}
  .callout{
    background:rgba(162,0,255,0.08);border-left:3px solid var(--primario);
    border-radius:6px;padding:10px 12px;font-size:11px;color:#ddd;
    margin:10px 0;line-height:1.5;
  }
  .callout.warn{background:rgba(255,149,0,0.08);border-left-color:#ff9500;}
  .callout b{color:var(--acento);}
  .optional-tag{
    font-size:9.5px;font-weight:800;color:var(--muted);
    background:rgba(255,255,255,0.06);padding:2px 8px;border-radius:99px;
    margin-left:6px;text-transform:uppercase;
  }
  .btn-generate{
    width:100%;padding:18px;border:none;border-radius:99px;
    background:linear-gradient(135deg,var(--primario-oscuro),var(--primario),var(--acento));
    color:#fff;font-family:inherit;font-size:16px;font-weight:900;
    text-transform:uppercase;letter-spacing:0.6px;cursor:pointer;
    box-shadow:0 8px 30px rgba(162,0,255,0.4);margin-top:8px;
  }
  .btn-generate:active{transform:scale(0.98);}
  #resultado{display:none;}
  #resultado.show{display:block;}
  #promptOutput{
    width:100%;min-height:280px;background:#0d0512;border:1px solid var(--border);
    border-radius:10px;color:#ddd;font-family:'Courier New',monospace;font-size:11px;
    padding:14px;line-height:1.6;white-space:pre-wrap;
  }
  .action-btns{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap;}
  .action-btns button, .action-btns a{
    flex:1;min-width:150px;text-align:center;padding:13px 16px;border-radius:99px;
    font-size:12.5px;font-weight:800;text-transform:uppercase;letter-spacing:0.4px;
    cursor:pointer;border:none;text-decoration:none;display:inline-block;
  }
  .btn-copy{background:var(--primario);color:#fff;}
  .btn-download{background:#22c55e;color:#0a1f0f;}
  .copied-msg{
    font-size:11px;color:#22c55e;font-weight:700;margin-top:8px;display:none;
  }
  .copied-msg.show{display:block;}
  footer{
    text-align:center;font-size:10.5px;color:#665;padding:30px 20px 10px 20px;
  }
  .required::after{content:" *";color:var(--acento);}
</style>
</head>
<body>

<header class="hero">
  <div class="kicker">Ramiro Sánchez · Material del curso</div>
  <h1>TIENDANUBE: LANDING PAGES <span>COMO EXPERTO</span></h1>
  <p>Completá este formulario con la info de tu producto. Al final vas a
  poder copiar un prompt listo para enviarle a Claude junto con el código
  base, y te devuelve la landing armada.</p>
</header>

<main>

  <div class="callout">
    <b>Cómo funciona:</b> completá los campos con tu producto. Los textos
    de marketing más finos (algunas frases de venta, redacción de preguntas
    frecuentes, etc.) los termina de escribir Claude por vos, basándose en
    lo que completes acá — no hace falta que sepas de copywriting.
  </div>

  <!-- 1. DATOS GENERALES -->
  <div class="card">
    <h2><span class="n">1</span> Datos generales</h2>
    <label class="required">Nombre del producto</label>
    <input type="text" id="nombreProducto" placeholder="Ej: Auriculares Bluetooth XYZ">

    <label>URL del producto en tu tienda</label>
    <input type="text" id="slugURL" placeholder="https://tutienda.com/productos/tu-producto/">

    <label class="required">Descripción breve de lo que vende</label>
    <textarea id="descripcion" placeholder="Contá en 2-4 líneas qué es el producto, para quién es y qué lo hace especial. Esto es lo más importante que completes: con esto Claude redacta el resto del contenido de venta."></textarea>
  </div>

  <!-- 2. COLORES -->
  <div class="card">
    <h2><span class="n">2</span> Colores de marca</h2>
    <p class="hint">Elegí un color principal. Los otros dos tonos de la landing se calculan solos a partir de este.</p>
    <div class="color-row">
      <input type="color" id="colorPrincipal" value="#a200ff">
      <div style="flex:1">
        <label style="margin:0 0 2px 0">Color principal</label>
        <div class="hint" style="margin:0">Botones, precios, acentos</div>
      </div>
    </div>
    <div class="swatches">
      <div class="swatch"><div class="box" id="swPrincipal"></div><span>PRINCIPAL</span></div>
      <div class="swatch"><div class="box" id="swOscuro"></div><span>OSCURO</span></div>
      <div class="swatch"><div class="box" id="swAcento"></div><span>ACENTO</span></div>
    </div>
  </div>

  <!-- 3. PRECIO Y PAGOS -->
  <div class="card">
    <h2><span class="n">3</span> Precio y formas de pago</h2>
    <div class="row2">
      <div>
        <label class="required">Precio final</label>
        <input type="text" id="precioFinal" placeholder="$45.000">
      </div>
      <div>
        <label>Precio de lista (tachado)</label>
        <input type="text" id="precioLista" placeholder="$60.000 (o vacío)">
      </div>
    </div>

    <div class="toggle-row" style="margin-top:14px">
      <span>¿Ofrecés cuotas sin interés?</span>
      <label class="switch"><input type="checkbox" id="cuotasActivo"><span class="slider"></span></label>
    </div>
    <div class="conditional" id="cuotasFields">
      <div class="row2">
        <div><label>Cantidad de cuotas</label><input type="text" id="cuotasCantidad" placeholder="3"></div>
        <div><label>Monto de cada cuota</label><input type="text" id="cuotasMonto" placeholder="$15.000"></div>
      </div>
    </div>

    <div class="toggle-row">
      <span>¿Descuento por transferencia?</span>
      <label class="switch"><input type="checkbox" id="transferActivo"><span class="slider"></span></label>
    </div>
    <div class="conditional" id="transferFields">
      <div class="row2">
        <div><label>Precio por transferencia</label><input type="text" id="transferPrecio" placeholder="$38.000"></div>
        <div><label>% descuento</label><input type="text" id="transferPct" placeholder="20"></div>
      </div>
    </div>
  </div>

  <!-- 4. FOTOS: CARRUSEL CLIENTES -->
  <div class="card">
    <h2><span class="n">4</span> Fotos: carrusel de clientes</h2>
    <p class="hint">Pegá el <b>link directo</b> de cada foto (el que te da Cloudinary o similar — ver capítulo 6 de la guía). Formato vertical recomendado.</p>
    <div class="foto-item"><div class="foto-label">📸 Foto 1</div><input type="text" id="carrusel1" placeholder="https://..."></div>
    <div class="foto-item"><div class="foto-label">📸 Foto 2</div><input type="text" id="carrusel2" placeholder="https://..."></div>
    <div class="foto-item"><div class="foto-label">📸 Foto 3</div><input type="text" id="carrusel3" placeholder="https://..."></div>
    <div class="foto-item"><div class="foto-label">📸 Foto 4</div><input type="text" id="carrusel4" placeholder="https://..."></div>
  </div>

  <!-- 5. ANTES Y DESPUES -->
  <div class="card">
    <h2><span class="n">5</span> Fotos: antes y después</h2>
    <p class="hint">Mismo encuadre en ambas fotos para que el comparador se vea prolijo. Si tu producto no tiene un "antes/después" claro, dejalo vacío y avisale a Claude en los comentarios del final.</p>
    <div class="foto-item"><div class="foto-label">⬅️ Antes</div><input type="text" id="antesUrl" placeholder="https://..."></div>
    <div class="foto-item"><div class="foto-label">➡️ Después</div><input type="text" id="despuesUrl" placeholder="https://..."></div>
  </div>

  <!-- 6. USO EN EL DIA A DIA -->
  <div class="card">
    <h2><span class="n">6</span> Fotos: uso en el día a día</h2>
    <p class="hint">4 fotos con una frase corta cada una (ej: "SE CONECTA SOLO", "SIN CABLES").</p>
    <div class="foto-item">
      <div class="foto-label">🖼️ Foto 1</div>
      <input type="text" id="uso1link" placeholder="Link de la foto" style="margin-bottom:6px">
      <input type="text" id="uso1texto" placeholder="Frase corta (ej: SIN CABLES)">
    </div>
    <div class="foto-item">
      <div class="foto-label">🖼️ Foto 2</div>
      <input type="text" id="uso2link" placeholder="Link de la foto" style="margin-bottom:6px">
      <input type="text" id="uso2texto" placeholder="Frase corta">
    </div>
    <div class="foto-item">
      <div class="foto-label">🖼️ Foto 3</div>
      <input type="text" id="uso3link" placeholder="Link de la foto" style="margin-bottom:6px">
      <input type="text" id="uso3texto" placeholder="Frase corta">
    </div>
    <div class="foto-item">
      <div class="foto-label">🖼️ Foto 4</div>
      <input type="text" id="uso4link" placeholder="Link de la foto" style="margin-bottom:6px">
      <input type="text" id="uso4texto" placeholder="Frase corta">
    </div>
  </div>

  <!-- 7. VIDEO -->
  <div class="card">
    <h2><span class="n">7</span> Video de cliente</h2>
    <div class="callout warn">
      Tiene que ser un <b>link directo a un archivo .mp4</b>, no el link de
      un posteo de Instagram (esos no se pueden insertar directo en la
      página). Si tenés el reel guardado, descargalo y subilo a tu hosting
      de imágenes/videos para conseguir el link directo — formato vertical,
      igual que un reel.
    </div>
    <label>Link del video (.mp4)</label>
    <input type="text" id="videoUrl" placeholder="https://.../video.mp4">
  </div>

  <!-- 8. APPS / USOS COMPATIBLES (opcional) -->
  <div class="card">
    <h2><span class="n">8</span> Apps o usos compatibles <span class="optional-tag">Opcional</span></h2>
    <div class="toggle-row">
      <span>¿Tu producto se conecta con apps o tiene distintos modos de uso?</span>
      <label class="switch"><input type="checkbox" id="appsActivo"><span class="slider"></span></label>
    </div>
    <div class="conditional" id="appsFields">
      <p class="hint">Nombre de cada app/modo (el ícono lo resuelve Claude si no tenés uno propio).</p>
      <div class="row2">
        <input type="text" id="app1" placeholder="App/modo 1">
        <input type="text" id="app2" placeholder="App/modo 2">
      </div>
      <div class="row2" style="margin-top:10px">
        <input type="text" id="app3" placeholder="App/modo 3">
        <input type="text" id="app4" placeholder="App/modo 4">
      </div>
    </div>
  </div>

  <!-- 9. PROBLEMA -->
  <div class="card">
    <h2><span class="n">9</span> El problema que resuelve <span class="optional-tag">Opcional</span></h2>
    <p class="hint">Escribilo con tus palabras si querés controlar el mensaje. Si lo dejás vacío, Claude lo redacta según la descripción del producto.</p>
    <textarea id="problema" placeholder="Ej: mis clientes se cansan de que el cable del CarPlay se corte y se enrede..."></textarea>
  </div>

  <!-- 10. SOLUCION -->
  <div class="card">
    <h2><span class="n">10</span> Cómo lo resuelve tu producto <span class="optional-tag">Opcional</span></h2>
    <p class="hint">Beneficios o características principales, en tus palabras. Si lo dejás vacío, Claude lo redacta.</p>
    <textarea id="solucion" placeholder="Ej: se conecta solo por Bluetooth, funciona con iPhone y Android, instalación en 5 minutos..."></textarea>
  </div>

  <!-- 11. GARANTIA -->
  <div class="card">
    <h2><span class="n">11</span> Garantía</h2>
    <input type="text" id="garantia" placeholder="Ej: 30 días, cambio o devolución sin preguntas">
  </div>

  <!-- 12. COMENTARIOS LIBRES -->
  <div class="card">
    <h2><span class="n">12</span> Comentarios para Claude <span class="optional-tag">Opcional</span></h2>
    <p class="hint">Testimonios reales, preguntas frecuentes que te hacen seguido, o cualquier otro pedido especial para esta landing.</p>
    <textarea id="comentarios" placeholder="Ej: tengo estos 2 testimonios reales... / mis clientes siempre preguntan por el envío a Tierra del Fuego..."></textarea>
  </div>

  <button class="btn-generate" onclick="generarPrompt()">✨ Generar prompt</button>

  <div id="resultado" class="card">
    <h2>📋 Tu prompt está listo</h2>
    <p class="hint">Copiá este texto y mandaselo a Claude junto con el archivo base (botón de descarga abajo). Podés pegarlo directo en el chat.</p>
    <textarea id="promptOutput" readonly></textarea>
    <div class="action-btns">
      <button class="btn-copy" onclick="copiarPrompt()">📋 Copiar prompt</button>
      <a class="btn-download" onclick="descargarBase()">⬇️ Descargar código base</a>
    </div>
    <div class="copied-msg" id="copiedMsg">✔ Copiado al portapapeles</div>
  </div>

</main>

<footer>Ramiro Sánchez · Material exclusivo del curso Tiendanube: Landing Pages Como Experto</footer>

<script>
// ---------- Utilidades de color ----------
function hexToHsl(hex){
  let r=parseInt(hex.slice(1,3),16)/255, g=parseInt(hex.slice(3,5),16)/255, b=parseInt(hex.slice(5,7),16)/255;
  let max=Math.max(r,g,b), min=Math.min(r,g,b), h,s,l=(max+min)/2;
  if(max===min){h=s=0;}
  else{
    let d=max-min; s=l>0.5?d/(2-max-min):d/(max+min);
    switch(max){
      case r: h=(g-b)/d+(g<b?6:0); break;
      case g: h=(b-r)/d+2; break;
      case b: h=(r-g)/d+4; break;
    }
    h/=6;
  }
  return [h*360,s*100,l*100];
}
function hslToHex(h,s,l){
  s/=100; l/=100;
  let c=(1-Math.abs(2*l-1))*s, x=c*(1-Math.abs((h/60)%2-1)), m=l-c/2, r,g,b;
  if(h<60){r=c;g=x;b=0;} else if(h<120){r=x;g=c;b=0;} else if(h<180){r=0;g=c;b=x;}
  else if(h<240){r=0;g=x;b=c;} else if(h<300){r=x;g=0;b=c;} else {r=c;g=0;b=x;}
  let toHex=v=>Math.round((v+m)*255).toString(16).padStart(2,'0');
  return '#'+toHex(r)+toHex(g)+toHex(b);
}
function calcularPaleta(hex){
  let [h,s,l]=hexToHsl(hex);
  let oscuro=hslToHex(h,Math.min(100,s+5),Math.max(0,l-15));
  let acento=hslToHex(h,Math.max(0,s-10),Math.min(100,l+15));
  return {principal:hex, oscuro, acento};
}
function actualizarSwatches(){
  let hex=document.getElementById('colorPrincipal').value;
  let p=calcularPaleta(hex);
  document.getElementById('swPrincipal').style.background=p.principal;
  document.getElementById('swOscuro').style.background=p.oscuro;
  document.getElementById('swAcento').style.background=p.acento;
}
document.getElementById('colorPrincipal').addEventListener('input',actualizarSwatches);
actualizarSwatches();

// ---------- Toggles condicionales ----------
function bindToggle(checkboxId, fieldsId){
  var cb=document.getElementById(checkboxId), f=document.getElementById(fieldsId);
  cb.addEventListener('change',function(){ f.classList.toggle('show', cb.checked); });
}
bindToggle('cuotasActivo','cuotasFields');
bindToggle('transferActivo','transferFields');
bindToggle('appsActivo','appsFields');

// ---------- Generar prompt ----------
function v(id){ return document.getElementById(id).value.trim(); }
function vOr(id, fallback){ var val=v(id); return val ? val : fallback; }

function generarPrompt(){
  var nombre=v('nombreProducto');
  if(!nombre){ alert('Completá al menos el nombre del producto.'); return; }
  var descripcion=vOr('descripcion','(el cliente no completó descripción — inferir del resto de los datos)');
  var paleta=calcularPaleta(document.getElementById('colorPrincipal').value);

  var cuotasTxt = document.getElementById('cuotasActivo').checked
    ? (v('cuotasCantidad')||'3')+' cuotas de '+(v('cuotasMonto')||'(no especificado)')
    : 'no ofrece';
  var transferTxt = document.getElementById('transferActivo').checked
    ? (v('transferPrecio')||'(no especificado)')+' ('+(v('transferPct')||'0')+'% OFF)'
    : 'no ofrece';

  var fotosCarrusel=[1,2,3,4].map(function(i){ return (i)+'. '+vOr('carrusel'+i,'(sin foto — usar placeholder)'); }).join('\n');
  var fotosUso=[1,2,3,4].map(function(i){
    var link=vOr('uso'+i+'link','(sin foto)');
    var texto=vOr('uso'+i+'texto','(sin frase — redactar una corta)');
    return i+'. '+link+' — "'+texto+'"';
  }).join('\n');

  var appsTxt='no aplica a este producto';
  if(document.getElementById('appsActivo').checked){
    var apps=[1,2,3,4].map(function(i){ return v('app'+i); }).filter(Boolean);
    if(apps.length) appsTxt=apps.join(', ')+' (Claude elige íconos representativos para cada uno)';
  }

  var problemaTxt = v('problema') ? v('problema') : '(no especificado por el cliente — redactalo vos en base a la descripción del producto, 4 puntos concretos)';
  var solucionTxt = v('solucion') ? v('solucion') : '(no especificado por el cliente — redactalo vos en base a la descripción del producto, 4 features concretos)';
  var comentarios = v('comentarios') ? v('comentarios') : '(sin comentarios adicionales)';
  var garantia = vOr('garantia','(no especificada — proponé una garantía estándar razonable y avisame que la definí yo)');

  var prompt =
'PEDIDO DE LANDING PAGE — '+nombre+'\n\n'+
'Hola Claude. Adjunto el archivo template-landing-tiendanube-BASE.html.\n'+
'Necesito que completes el CONFIG de ese archivo con la información de\n'+
'abajo y me devuelvas el archivo completo, listo para pegar en Tiendanube.\n\n'+
